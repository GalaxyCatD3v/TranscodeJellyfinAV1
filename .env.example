# SSHFS Connection & Authentication Configuration
# Rename or copy this file to .env and fill in your SSH credentials

# SSH Host / IP address of your remote Jellyfin server / LXC container
SSH_HOST=192.168.1.180

# SSH Username
SSH_USER=root

# SSH Port (default: 22)
SSH_PORT=22

# SSH Password (passed securely via stdin to sshfs.exe -opassword_stdin)
SSH_PASSWORD=your_ssh_password_here

# Remote path on the SSH server to mount (default: /)
SSH_REMOTE_PATH=/

# Local Windows Drive letter to mount SSHFS to (default: Y:)
SSHFS_MOUNT_DRIVE=Y:

# Volume Name label displayed in Windows Explorer
SSHFS_VOLNAME=jellyfin docker lxc

# Path to sshfs.exe binary
SSHFS_EXE=C:\Program Files\SSHFS-Win\bin\sshfs.exe

# Enable debug logging for SSHFS (true/false)
SSHFS_DEBUG=true
SSHFS_LOGLEVEL=debug1

# Max readahead buffer for high-throughput streaming
SSHFS_MAX_READAHEAD=1GB

# Automatically attempt to mount SSHFS during pre-flight checks if Y: is not mounted
SSHFS_AUTO_MOUNT=true
